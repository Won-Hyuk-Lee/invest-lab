# Copy values into your local .env. Never commit credentials.
# Select runtime mode with INVEST_MODE=local_simulation, kis_paper or kis_live in your shell.
# INVEST_WORKSPACE defaults to execution. Archived research requires research in your shell.
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_ACCOUNT_NUMBER=
KIS_PAPER_ACCOUNT_PRODUCT_CODE=01
KIS_PAPER_HTS_ID=
KIS_PAPER_ORDERS_ENABLED=false
# Live credentials are read only when kis_live is selected. No paper-key fallback.
KIS_LIVE_APP_KEY=
KIS_LIVE_APP_SECRET=
KIS_LIVE_ACCOUNT_NUMBER=
KIS_LIVE_ACCOUNT_PRODUCT_CODE=01
KIS_LIVE_ORDERS_ENABLED=false
KIS_REQUEST_INTERVAL=1.25
DART_API_KEY=
FRED_API_KEY=
KRX_API_KEY=
